{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NightDisplay",
  "version": "4.0.1",
  "identifier": "com.nightdisplay.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NightDisplay",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true,
        "backgroundColor": [
          15,
          19,
          25,
          255
        ]
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}